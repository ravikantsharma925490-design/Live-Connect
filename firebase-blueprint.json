        "referenceId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "actorId", "type", "title", "message", "isRead", "createdAt"]
    },
    "ProblemReport": {
      "title": "ProblemReport",
